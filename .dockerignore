# .dockerignore
# 코드 리뷰 참고 URL - https://chatgpt.com/c/691d6f71-6a90-8321-951f-e270ab4aa753

# -------------------------------
# 기본 제외 대상
# -------------------------------
.git
.gitignore
Dockerfile
docker-compose.yml
README.md
LICENSE
reference.txt
.notes/
*.md

# -------------------------------
# Python 캐시 / 빌드 파일
# -------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.egg-info/
*.egg
build/
dist/
*.whl

# -------------------------------
# 개발 환경 및 가상 환경
# -------------------------------
venv/
.env
.env.*
.pyenv/
pip-wheel-metadata/
pip-log.txt
.Python

# -------------------------------
# IDE / 에디터 관련 파일
# -------------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------------
# OS 및 자동 생성 파일
# -------------------------------
Thumbs.db
.DS_Store
Desktop.ini

# -------------------------------
# 로그 및 디버깅 디렉터리
# -------------------------------
*.log
logs/
debug/
trace/

# -------------------------------
# 테스트용 코드/데이터 (필요 시 포함 가능)
# -------------------------------
tests/
test_*.py
test/
tmp/
temp/
backup/

# -------------------------------
# 대용량 또는 불필요한 리소스
# -------------------------------
*.zip
*.tar
*.gz
*.rar
*.7z
*.mp4
*.avi
*.mov
*.xlsx
*.docx
*.pptx
*.psd
*.pdf

# -------------------------------
# 프로젝트 내 불필요한 폴더
# (아마존 웹서비스 이미지에 넣을 필요 없음)
# -------------------------------
chatbot_env/
resources/image/
resources/text/